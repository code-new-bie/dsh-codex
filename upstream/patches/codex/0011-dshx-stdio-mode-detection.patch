+    pub async fn request_json_rpc(&self, request: JSONRPCRequest) -> IoResult<RequestResult> {
         let (response_tx, response_rx) = oneshot::channel();
         self.command_tx.send(StdioClientCommand::Request { request: Box::new(request), response_tx }).await
             .map_err(|_| IoError::new(ErrorKind::BrokenPipe, "stdio app-server worker is closed"))?;
         response_rx.await.map_err(|_| IoError::new(ErrorKind::BrokenPipe, "stdio request response channel is closed"))?
     }
