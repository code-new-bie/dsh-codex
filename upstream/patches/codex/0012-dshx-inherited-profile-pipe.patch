-fn main() -> anyhow::Result<()> {
+#[cfg(unix)]
+fn dshx_make_blocking(fd: i32) -> anyhow::Result<()> {
+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFL) };
+    if flags == -1 {
+        return Err(anyhow::anyhow!("failed to read DSHX pipe flags for fd {fd}: {}", std::io::Error::last_os_error()));
+    }
+    if flags & libc::O_NONBLOCK != 0 {
+        let result = unsafe { libc::fcntl(fd, libc::F_SETFL, flags & !libc::O_NONBLOCK) };
+        if result == -1 {
+            return Err(anyhow::anyhow!("failed to clear O_NONBLOCK for DSHX fd {fd}: {}", std::io::Error::last_os_error()));
+        }
+    }
+    Ok(())
+}
+
+fn dshx_env_fd(name: &str) -> anyhow::Result<i32> {
+    std::env::var(name)
+        .map_err(|_| anyhow::anyhow!("{name} is required; DSHX never falls back to the Codex agent runtime"))?
+        .parse()
+        .map_err(|err| anyhow::anyhow!("invalid {name}: {err}"))
+}
+
+#[cfg(unix)]
+fn dshx_prepare_stdio(input_fd: i32, terminal_fd: i32, output_fd: i32) -> anyhow::Result<(i32, i32)> {
+    if input_fd != libc::STDIN_FILENO {
+        anyhow::bail!("DSHX_APP_SERVER_INPUT_FD must be child stdin (fd 0)");
+    }
+    if terminal_fd < 3 || output_fd < 3 || terminal_fd == output_fd {
+        anyhow::bail!("DSHX terminal/protocol output fds must be distinct inherited descriptors >= 3");
+    }
+    let saved_input = unsafe { libc::dup(input_fd) };
+    if saved_input < 0 {
+        return Err(anyhow::anyhow!("failed to preserve DSHX protocol input: {}", std::io::Error::last_os_error()));
+    }
+    if unsafe { libc::dup2(terminal_fd, libc::STDIN_FILENO) } < 0 {
+        unsafe { libc::close(saved_input) };
+        return Err(anyhow::anyhow!("failed to restore terminal stdin: {}", std::io::Error::last_os_error()));
+    }
+    dshx_make_blocking(saved_input)?;
+    dshx_make_blocking(output_fd)?;
+    Ok((saved_input, output_fd))
+}
+
+#[cfg(windows)]
+unsafe extern "C" {
+    fn _dup(fd: i32) -> i32;
+    fn _dup2(source: i32, target: i32) -> i32;
+    fn _close(fd: i32) -> i32;
+    fn _get_osfhandle(fd: i32) -> isize;
+}
+
+#[cfg(windows)]
+fn dshx_prepare_stdio(input_fd: i32, terminal_fd: i32, output_fd: i32) -> anyhow::Result<(i32, i32)> {
+    if input_fd != 0 {
+        anyhow::bail!("DSHX_APP_SERVER_INPUT_FD must be child stdin (fd 0)");
+    }
+    if terminal_fd < 3 || output_fd < 3 || terminal_fd == output_fd {
+        anyhow::bail!("DSHX terminal/protocol output fds must be distinct inherited descriptors >= 3");
+    }
+    let terminal_handle = unsafe { _get_osfhandle(terminal_fd) };
+    if terminal_handle == -1 {
+        return Err(anyhow::anyhow!("failed to resolve inherited terminal stdin: {}", std::io::Error::last_os_error()));
+    }
+    let saved_input = unsafe { _dup(input_fd) };
+    if saved_input < 0 {
+        return Err(anyhow::anyhow!("failed to preserve DSHX protocol input: {}", std::io::Error::last_os_error()));
+    }
+    if unsafe { _dup2(terminal_fd, 0) } != 0 {
+        unsafe { _close(saved_input) };
+        return Err(anyhow::anyhow!("failed to restore CRT terminal stdin: {}", std::io::Error::last_os_error()));
+    }
+    let restored = unsafe {
+        windows_sys::Win32::System::Console::SetStdHandle(
+            windows_sys::Win32::System::Console::STD_INPUT_HANDLE,
+            terminal_handle as _,
+        )
+    };
+    if restored == 0 {
+        unsafe { _close(saved_input) };
+        return Err(anyhow::anyhow!("failed to restore Win32 terminal stdin: {}", std::io::Error::last_os_error()));
+    }
+    Ok((saved_input, output_fd))
+}
